# Local defaults. Preview and Production must use their matching stable aliases.
FIREWALL_UI_BASE_URL=http://localhost:3001
MCP_PUBLIC_BASE_URL=http://localhost:3002
# Generate a distinct value for every environment. Never commit a real value.
MCP_OAUTH_STATE_SECRET=
MCP_AUTH0_ORGANIZATION=
MCP_ADDITIONAL_ALLOWED_ORIGINS=
# Clamped to a 5000000 byte hard ceiling.
MCP_MAX_RESPONSE_BYTES=1000000
MCP_AUDIT_URL=
# Fail-open public tool-call activity emission. Keep disabled until firewall-ui
# has the same shared key and its activity ingest is enabled.
MCP_ACTIVITY_ENABLED=false
MCP_ACTIVITY_INGEST_KEY=
